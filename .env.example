# Copy to .env for local runs. On Render, set these in the dashboard (Environment).
PORT=8080

# Telegram user account (https://my.telegram.org -> API development tools)
TG_API_ID=
TG_API_HASH=
# Session string of the account: Telethon/GramJS StringSession (starts with "1") or a Pyrogram session string.
# Leave empty to boot without Telegram (/health shows "telegram: not configured").
TG_SESSION=

# Which channel: numeric id (-100...) OR the exact channel title
CHANNEL_ID=
CHANNEL_TITLE=

# Auth: Firebase project id for verifying user ID tokens, and a random 32+ char secret for signed URLs
FIREBASE_PROJECT_ID=
SIGNING_SECRET=
# Optional: the app sends this in header X-App-Key (or ?k=) to list videos without a user login
APP_KEY=

# Chunk cache
CACHE_DIR=/tmp/cache
CACHE_MAX_GB=1

# Push notifications (POST /api/push). FCM_SERVICE_ACCOUNT = the service-account key JSON (or base64 of it); keep it secret.
FCM_SERVICE_ACCOUNT=
OWNER_EMAIL=
ADMIN_ORIGINS=
PUSH_CHANNEL_ID=
# PUSH_RATE_PER_MIN=20

# Admin uploads (/api/upload): files go into GitHub release assets of one repo.
# GITHUB_UPLOAD_TOKEN = fine-grained token with access to UPLOAD_REPO only: Contents read/write (+ Actions read/write for quality copies). Keep it secret.
GITHUB_UPLOAD_TOKEN=
UPLOAD_REPO=                # owner/name
UPLOAD_RELEASE_PDF=         # release tag for PDFs (created if missing)
UPLOAD_RELEASE_VIDEO=       # release tag for MP4 videos (created if missing)
UPLOAD_QUALITY_WORKFLOW=    # optional: workflow file in UPLOAD_REPO that makes 720p/480p/360p copies
# UPLOAD_WORKFLOW_REF=main

# Optional
# AUTH_MODE=firebase        # off = no auth (local testing only)
# RATE_LIMIT_PER_MIN=600
# PUBLIC_BASE_URL=
# CORS_ORIGIN=
# ADMIN_KEY=
# BOT_TOKEN=                # optional fallback: a bot that is admin of the channel (needs CHANNEL_ID)

# Member room pushes (POST /api/room-push), all optional
# ROOM_PUSH_CONFIG_DOC=app_config/community
# ROOM_PUSH_SWITCH=chatPushEnabled
# ROOM_PUSH_MSG_PATH=batches/{room}/chat/{msg}
# ROOM_PUSH_ROOM_DOC=batches/{room}
# ROOM_PUSH_TITLE_FIELD=title
# ROOM_PUSH_TOPIC_PREFIX=chat_
# ROOM_PUSH_RATE_PER_MIN=6
